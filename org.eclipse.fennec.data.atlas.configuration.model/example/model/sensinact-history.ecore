<?xml version="1.0" encoding="UTF-8"?>
<!-- Domain model for the SensiNact history database (the TimescaleDB store the
     Event Atlas writes twin updates into).

     This model describes a schema the Data Atlas does NOT own: it belongs to
     SensiNact's history provider, which creates schema `sensinact` with ONE
     hypertable `history` (verified against TimescaleSql, sensiNact 12ee7d94f):
     every recorded value is one row, the kind of the value is the discriminator
     column value_kind (0 NUMBER, 1 BOOLEAN, 2 STRING, 3 GEOJSON, 4 OBJECT), a
     number lives in value_num, everything else as a JSON document in
     value_json. The single EClass here is that table, column by column. The
     attribute names are EMF-side names; the mapping onto the real lower-case,
     schema-qualified column names is pinned explicitly in the inline
     persistenceConfig of the configuration (dataatlas-history.xmi), because the
     derived eorm naming would expect an upper-cased, unqualified table.

     The per-kind endpoints of the example (numeric, text, geo) are DataSets
     with a canonical query over valueKind, pushed down into the database - no
     views are installed next to the provider's table.

     The table carries no primary key. JPA needs an identity, so the mapping
     declares a composite id over (time, provider, service, resource) - the
     natural reading of a time series per resource. -->
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="sensinactHistory"
    nsURI="https://eclipse.org/fennec/data/atlas/example/sensinact/history/1.0.0"
    nsPrefix="history">
  <eClassifiers xsi:type="ecore:EClass" name="HistoryEntry">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="One recorded resource value - a row of table sensinact.history. Which of valueNum and valueJson carries the value is told by valueKind: 0 NUMBER (valueNum), 1 BOOLEAN, 2 STRING, 3 GEOJSON and 4 OBJECT (valueJson, a JSON document: true/false, a JSON string, a GeoJSON geometry or Feature, an object)."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="time" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Recording timestamp - the hypertable's partitioning column (TIMESTAMPTZ). Part of the composite id."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="modelPackageUri"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="nsURI of the model package the provider belongs to (column modelpackageuri, nullable upstream)."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="model" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Name of the provider's model (nullable upstream)."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="provider" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Provider id. Part of the composite id."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="service" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Service name within the provider. Part of the composite id."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="resource" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Resource name within the service. Part of the composite id."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="valueKind" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The kind of the recorded value (column value_kind, SMALLINT): the ordinal of the provider's ValueKind - 0 NUMBER, 1 BOOLEAN, 2 STRING, 3 GEOJSON, 4 OBJECT."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="javaType" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The Java type the provider recorded the value as (column java_type), e.g. java.lang.Double; informational."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="valueNum" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBigDecimal">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The value of a NUMBER row (column value_num). NUMERIC is arbitrary precision, so EBigDecimal rather than EDouble; null for every other kind."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="valueJson" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The value of every non-NUMBER row as its JSON text (column value_json, JSONB): true/false for a BOOLEAN, a quoted JSON string for a STRING, a GeoJSON geometry or Feature for a GEOJSON, an object for an OBJECT; null for a NUMBER."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
</ecore:EPackage>
