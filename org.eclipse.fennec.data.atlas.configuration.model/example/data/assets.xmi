  </asset:Pool>
  <asset:Pool id="pool-outdoor" name="Outdoor pool"
      minX="11.6195" minY="50.9065" maxX="11.6195" maxY="50.9065" accessible="false" lastInspection="2025-09-20T00:00:00.000+0000"
      depthMax="1.8" waterTemperature="22.0">
    <geometry xsi:type="geo-json:Point" data="ACED0005757200025B443EA68C14AB635A1E02000078700000000240273D2F1A9FBE77404974083126E979"/>
  </asset:Pool>
  <asset:Slide id="slide-black" name="Black hole"
      minX="11.6175" minY="50.9060" maxX="11.6175" maxY="50.9060" accessible="false" lastInspection="2026-04-11T00:00:00.000+0000"
      length="82.0">
    <geometry xsi:type="geo-json:Point" data="ACED0005757200025B443EA68C14AB635A1E02000078700000000240273C28F5C28F5C404973F7CED91687"/>
  </asset:Slide>
  <asset:Slide id="slide-family" name="Family slide"
      minX="11.6172" minY="50.9054" maxX="11.6172" maxY="50.9054" accessible="true" lastInspection="2026-04-11T00:00:00.000+0000"
      length="24.0">
    <geometry xsi:type="geo-json:Point" data="ACED0005757200025B443EA68C14AB635A1E02000078700000000240273C01A36E2EB2404973E425AEE632"/>
  </asset:Slide>
  <asset:Bench id="bench-1" name="Bench at the kids pool"
      minX="11.6168" minY="50.9051" maxX="11.6168" maxY="50.9051" accessible="true" lastInspection="2026-01-10T00:00:00.000+0000"
      seats="4">
    <geometry xsi:type="geo-json:Point" data="ACED0005757200025B443EA68C14AB635A1E02000078700000000240273BCD35A85879404973DA5119CE07"/>
  </asset:Bench>
  <asset:Bench id="bench-2" name="Bench at the outdoor pool"
