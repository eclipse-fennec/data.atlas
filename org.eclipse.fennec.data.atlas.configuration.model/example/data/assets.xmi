<?xml version="1.0" encoding="UTF-8"?>
<!-- Assets of a leisure pool around Jena (CRS84 longitude/latitude): the data of the
     example OGC API - Features service. The location of each asset is a GeoJSON
     point (the containment reference to the GeoJSON model's Geometry); the bbox
     attributes hold its bounding box, which the store filters on. The GeoJSON model
     keeps the coordinates in its derived 'data' attribute, which XMI writes as
     Java-serialized hex text - not meant to be edited by hand: the encoded values
     are the minX/minY pair of the same asset. -->
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:geo-json="https://geojson.org/model/2016" xmlns:asset="https://eclipse.org/fennec/data/atlas/example/asset/1.0.0">
  <asset:Pool id="pool-kids" name="Kids pool"
      minX="11.6170" minY="50.9052" maxX="11.6170" maxY="50.9052" accessible="true" lastInspection="2026-06-15T00:00:00.000+0000"
      depthMax="0.6" waterTemperature="31.0">
    <geometry xsi:type="geo-json:Point" data="ACED0005757200025B443EA68C14AB635A1E02000078700000000240273BE76C8B4396404973DD97F62B6B"/>
  </asset:Pool>
  <asset:Pool id="pool-sport" name="Sports pool"
      minX="11.6182" minY="50.9058" maxX="11.6182" maxY="50.9058" accessible="true" lastInspection="2026-05-02T00:00:00.000+0000"
      depthMax="2.0" waterTemperature="26.5">
