<?xml version="1.0" encoding="ASCII"?>
<qvtoperational:OperationalTransformation xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" xmlns:imperativeocl="http://www.eclipse.org/fennec/m2x/qvto/imperativeocl/1.0" xmlns:ocl="http://www.eclipse.org/fennec/m2x/ocl/1.0" xmlns:qvtoperational="http://www.eclipse.org/fennec/m2x/qvto/qvtoperational/1.0" name="PersonToPublic" entry="//PersonToPublic/main">
  <eClassifiers xsi:type="ecore:EClass" name="PersonToPublic">
    <eOperations xsi:type="qvtoperational:EntryOperation" name="main">
      <body>
        <content xsi:type="ocl:IteratorExp" name="collect">
          <ownedSource xsi:type="ocl:IteratorExp" name="select">
            <ownedSource xsi:type="ocl:OperationCallExp" name="rootObjects">
              <ownedSource xsi:type="ocl:VariableExp"/>
            </ownedSource>
            <ownedBody xsi:type="ocl:OperationCallExp" name="oclIsKindOf">
              <ownedSource xsi:type="ocl:VariableExp" referredVariable="//PersonToPublic/main/@body/@content.0/@ownedSource/@ownedIterators.0"/>
              <ownedArguments xsi:type="ocl:TypeExp"/>
            </ownedBody>
            <ownedIterators name="_xsel_it"/>
          </ownedSource>
          <ownedBody xsi:type="qvtoperational:MappingCallExp" name="toPublic">
            <ownedSource xsi:type="ocl:VariableExp" referredVariable="//PersonToPublic/main/@body/@content.0/@ownedIterators.0"/>
          </ownedBody>
          <ownedIterators name="_xmap_it"/>
        </content>
      </body>
    </eOperations>
    <eOperations xsi:type="qvtoperational:MappingOperation" name="toPublic">
      <body xsi:type="qvtoperational:MappingBody">
        <content xsi:type="imperativeocl:AssignExp" isReset="true">
          <left xsi:type="ocl:VariableExp"/>
          <value xsi:type="ocl:PropertyCallExp">
            <ownedSource xsi:type="ocl:VariableExp"/>
            <referredProperty xsi:type="ecore:EAttribute" href="../model/person.ecore#//Person/id"/>
          </value>
        </content>
        <content xsi:type="imperativeocl:AssignExp" isReset="true">
          <left xsi:type="ocl:VariableExp"/>
          <value xsi:type="ocl:OperationCallExp" name="+">
            <ownedSource xsi:type="ocl:OperationCallExp" name="+">
              <ownedSource xsi:type="ocl:PropertyCallExp">
                <ownedSource xsi:type="ocl:VariableExp"/>
                <referredProperty xsi:type="ecore:EAttribute" href="../model/person.ecore#//Person/firstName"/>
              </ownedSource>
              <ownedArguments xsi:type="ocl:StringLiteralExp" stringSymbol=" "/>
            </ownedSource>
            <ownedArguments xsi:type="ocl:PropertyCallExp">
              <ownedSource xsi:type="ocl:VariableExp"/>
              <referredProperty xsi:type="ecore:EAttribute" href="../model/person.ecore#//Person/lastName"/>
            </ownedArguments>
          </value>
        </content>
      </body>
      <context name="self">
        <eType xsi:type="ecore:EClass" href="../model/person.ecore#//Person"/>
      </context>
      <result name="result">
        <eType xsi:type="ecore:EClass" href="../model/person-public.ecore#//PublicPerson"/>
      </result>
    </eOperations>
  </eClassifiers>
  <modelParameter name="src"/>
  <modelParameter name="tgt" kind="out"/>
</qvtoperational:OperationalTransformation>
