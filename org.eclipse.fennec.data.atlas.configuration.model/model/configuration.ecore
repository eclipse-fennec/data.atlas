    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Per-DataSet configuration for a QGisDataService; maps a DataSet to a QGis layer."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="layer" lowerBound="1" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EClass">
