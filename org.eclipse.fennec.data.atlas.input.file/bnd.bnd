Bundle-Name: Fennec Data Atlas - File Input
Bundle-Description: Input configurator: tracks FileDataInput configuration services and \
	registers one EObjectSource per configuration, loading the EObjects from the configured \
	EMF resource file (or directory of files).
Bundle-Version: 1.0.0

-library: enableEMF

-buildpath: \
	org.osgi.service.component.annotations;version=latest,\
	org.eclipse.fennec.data.atlas.configuration.model;version=project,\
	org.eclipse.fennec.data.atlas.api;version=project
