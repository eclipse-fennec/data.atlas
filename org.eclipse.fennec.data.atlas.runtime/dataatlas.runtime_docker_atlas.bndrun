-include: dataatlas.runtime_base.bndrun

# Model-Atlas config mode flavour: the configuration is retrieved from a Model
# Atlas via the model.atlas client stack instead of being read from a file.
#
# NOTE: an -include OVERRIDES local properties, so a variant must never own a
# full -runbundles — the additions live in a merged -runbundles.* suffix on top
# of the base's resolved list (same pattern as model.atlas' docker variants).
# The set below was validated by a full resolve before being frozen here.
-runbundles.atlas: \
	org.eclipse.fennec.data.atlas.runtime.config.atlas;version=snapshot,\
	org.eclipse.fennec.model.atlas.rest.client.api;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.model.atlas.rest.client.impl;version='[0.1.0,0.1.1)',\
	org.eclipse.fennec.model.atlas.rest.client.osgi;version='[0.1.0,0.1.1)'

-runproperties.docker: \
	base.path=/opt/dataatlas,\
	logback.configurationFile=file:/opt/dataatlas/runtime/etc/logback.xml,\
	atlas.log.dir=/opt/dataatlas/runtime/log,\
	org.apache.felix.configadmin.plugin.interpolation.secretsdir=/opt/dataatlas/runtime/secrets,\
	data=/opt/dataatlas/runtime/data

-resolve: never
