-runprovidedcapabilities: ${native_capability}

# the Data Atlas registers its services (EPackages, config objects, EObjectSources)
# dynamically at runtime; the resolver cannot see them as capabilities
-resolve.effective: active;skip:="osgi.service"

-runpath.slf4j: ${slf4j.runpath}
-runsystempackages.slf4j: ${slf4j.systempackages}

slf4j.systempackages: \
	org.slf4j;version=2.0.17,\
	org.slf4j.helpers;version=2.0.17,\
	org.slf4j.spi;version=2.0.17

slf4j.runpath: \
	ch.qos.logback.classic;version='[1.5.18,1.5.19)',\
	ch.qos.logback.core;version='[1.5.18,1.5.19)',\
	jul.to.slf4j;version='[2.0.17,2.0.18)',\
	slf4j.api;version='[2.0.17,2.0.18)'

-runrequires: \
	bnd.identity;id='org.apache.felix.gogo.shell',\
	bnd.identity;id='org.apache.felix.gogo.command',\
	bnd.identity;id='org.apache.felix.configurator',\
	bnd.identity;id='org.apache.felix.configadmin.plugin.interpolation',\
	bnd.identity;id='org.apache.felix.configadmin',\
	bnd.identity;id='org.apache.felix.metatype',\
	bnd.identity;id='org.eclipse.fennec.data.atlas.runtime',\
	bnd.identity;id='org.eclipse.fennec.data.atlas.configuration.model',\
	bnd.identity;id='org.eclipse.fennec.data.atlas.runtime.config',\
	bnd.identity;id='org.eclipse.fennec.data.atlas.bootstrap',\
	bnd.identity;id='org.eclipse.fennec.data.atlas.input.file',\
	bnd.identity;id='org.eclipse.fennec.data.atlas.rest',\
	bnd.identity;id='org.eclipse.fennec.codec',\
	bnd.identity;id='org.eclipse.fennec.codec.rest',\
	bnd.identity;id='org.eclipse.fennec.emf.osgi.component.minimal',\
	bnd.identity;id='org.eclipse.osgitech.rest.servlet.whiteboard',\
	bnd.identity;id='org.apache.felix.http.jetty12'

# only one emf.osgi runtime stack: the codec bundles are built against the
# 1.1.0 line (component.minimal); a second ResourceSetFactory provider from
# the 0.1.x line leads to EPackages registered in one registry and
# resources loaded via the other
-runblacklist: \
	bnd.identity;id='org.eclipse.fennec.emf.osgi.component',\
	bnd.identity;id='org.eclipse.fennec.emf.osgi.component.minimal';version='[0.1.0,1.0.0)'

# org.eclipse.fennec.persistence.orm (pulled in by the eorm imports of
# configuration.model, unused at runtime here) requires emf.core=osgi in
# [0,1.0) which only the blacklisted 0.1.x emf.osgi line provides; the real
# fix is a persistence rebuild against the emf.osgi 1.1 line
-runsystemcapabilities.emfcore: emf.core;emf.core=osgi;version:Version=0.1.2

-runfw: org.apache.felix.framework;version='[7.0.5,7.0.5]'
-runee: JavaSE-21

-runstartlevel: \
	order = sortbynameversion, \
	begin = 1000, \
	step  =    1

# org.osgi.service.http.port=-1 disables the default felix.http instance;
# only the configured org.apache.felix.http~dataAtlas instance binds the port
-runproperties.base: \
	felix.cm.config.plugins=org.apache.felix.configadmin.plugin.interpolation,\
	org.osgi.service.http.port=-1
-runbundles: \
	com.fasterxml.jackson.core.jackson-annotations;version='[2.21.0,2.21.1)';startlevel=1000,\
	jakarta.activation-api;version='[2.1.3,2.1.4)';startlevel=1001,\
	jakarta.annotation-api;version='[2.1.1,2.1.2)';startlevel=1002,\
	jakarta.inject.jakarta.inject-api;version='[2.0.1,2.0.2)';startlevel=1003,\
	jakarta.validation.jakarta.validation-api;version='[3.0.2,3.0.3)';startlevel=1004,\
	jakarta.ws.rs-api;version='[3.1.0,3.1.1)';startlevel=1005,\
	jakarta.xml.bind-api;version='[4.0.2,4.0.3)';startlevel=1006,\
	javassist;version='[3.29.2,3.29.3)';startlevel=1007,\
	org.apache.aries.spifly.dynamic.bundle;version='[1.3.7,1.3.8)';startlevel=1008,\
	org.apache.felix.cm.json;version='[2.0.6,2.0.7)';startlevel=1009,\
	org.apache.felix.configadmin;version='[1.9.26,1.9.27)';startlevel=1010,\
	org.apache.felix.configadmin.plugin.interpolation;version='[1.2.8,1.2.9)';startlevel=1011,\
	org.apache.felix.configurator;version='[1.0.18,1.0.19)';startlevel=1012,\
