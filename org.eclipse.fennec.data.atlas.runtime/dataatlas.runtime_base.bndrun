	org.apache.felix.gogo.shell;version='[1.1.4,1.1.5)';startlevel=1015,\
	org.apache.felix.http.jetty12;version='[1.0.34,1.0.35)';startlevel=1016,\
	org.apache.felix.http.servlet-api;version='[6.1.0,6.1.1)';startlevel=1017,\
	org.apache.felix.metatype;version='[1.2.4,1.2.5)';startlevel=1018,\
	org.apache.felix.scr;version='[2.2.12,2.2.13)';startlevel=1019,\
	org.eclipse.emf.common;version='[2.44.0,2.44.1)';startlevel=1020,\
	org.eclipse.emf.ecore;version='[2.41.0,2.41.1)';startlevel=1021,\
