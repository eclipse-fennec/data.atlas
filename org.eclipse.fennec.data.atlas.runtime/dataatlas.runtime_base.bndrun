	org.eclipse.fennec.codec;version='[0.1.0,0.1.1)';startlevel=1023,\
	org.eclipse.fennec.codec.api;version='[0.1.0,0.1.1)';startlevel=1024,\
	org.eclipse.fennec.codec.metadata;version='[0.1.0,0.1.1)';startlevel=1025,\
	org.eclipse.fennec.codec.rest;version='[0.1.0,0.1.1)';startlevel=1026,\
	org.eclipse.fennec.data.atlas.api;version=snapshot;startlevel=1027,\
	org.eclipse.fennec.data.atlas.bootstrap;version=snapshot;startlevel=1028,\
