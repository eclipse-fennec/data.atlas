Bundle-Name: Fennec Data Atlas - Integration Tests
Bundle-Description: OSGi integration tests for the configuration -> REST vertical slice.

Test-Cases: ${classes;HIERARCHY_INDIRECTLY_ANNOTATED;org.junit.platform.commons.annotation.Testable;CONCRETE}

-library: \
	enableOSGi-Test,\
	enableEMF

# the bundles under test are on the buildpath so gradle builds their jars
# before resolve.test/testOSGi run (a clean CI checkout resolves against the
# workspace repository, which only serves already-built jars)
-buildpath: \
	org.osgi.framework;version=latest,\
	org.osgi.service.cm;version=latest,\
	org.eclipse.fennec.data.atlas.api;version=project,\
	org.eclipse.fennec.data.atlas.configuration.model;version=project,\
	org.eclipse.fennec.data.atlas.bootstrap;version=project,\
	org.eclipse.fennec.data.atlas.input.file;version=project,\
	org.eclipse.fennec.data.atlas.input.jpa;version=project,\
	org.eclipse.fennec.data.atlas.rest;version=project,\
	org.eclipse.fennec.persistence.repository;version=latest,\
	org.eclipse.fennec.persistence.capabilities;version=latest,\
	org.eclipse.fennec.persistence.query;version=latest,\
	org.eclipse.fennec.query.model;version=latest,\
	org.eclipse.fennec.expression.model;version=latest,\
	com.h2database;version=latest

Private-Package: \
	org.eclipse.fennec.data.atlas.tests

# the example configuration + data of the configuration model bundle is the test
# fixture; the lifecycle/coverage fixtures reuse its model and data via the same
# relative hrefs, so they are merged into the same folder. The atlas/ tree holds
# the Model-Atlas-mode fixtures (scope/registry configurator config + the
# schemas the seeder uploads), shared with the compose setup.
-includeresource: \
	data=../org.eclipse.fennec.data.atlas.configuration.model/example,\
	data=fixtures,\
	atlas/load=../docker/dockercompose/modelatlas/load,\
	atlas/models=../docker/dockercompose/seed/models,\
	atlas/models/configuration.ecore=../org.eclipse.fennec.data.atlas.configuration.model/model/configuration.ecore
