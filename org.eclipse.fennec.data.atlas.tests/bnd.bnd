Bundle-Name: Fennec Data Atlas - Integration Tests
Bundle-Description: OSGi integration tests for the configuration -> REST vertical slice.
Bundle-Version: 1.0.0

Test-Cases: ${classes;HIERARCHY_INDIRECTLY_ANNOTATED;org.junit.platform.commons.annotation.Testable;CONCRETE}

-library: \
	enableOSGi-Test,\
	enableEMF

-buildpath: \
	org.osgi.framework;version=latest,\
	org.osgi.service.cm;version=latest

Private-Package: \
	org.eclipse.fennec.data.atlas.tests

# the example configuration + data of the configuration model bundle is the test fixture
-includeresource: \
	data=../org.eclipse.fennec.data.atlas.configuration.model/example
