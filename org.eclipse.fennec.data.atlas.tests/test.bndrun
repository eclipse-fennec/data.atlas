-library: enableOSGi-Test

-runrequires: \
	bnd.identity;id='org.eclipse.fennec.data.atlas.tests',\
	bnd.identity;id='org.eclipse.fennec.data.atlas.bootstrap',\
	bnd.identity;id='org.eclipse.daanse.io.fs.watcher.watchservice',\
	bnd.identity;id='org.eclipse.fennec.data.atlas.input.file',\
	bnd.identity;id='org.eclipse.fennec.data.atlas.input.jpa',\
	bnd.identity;id='org.eclipse.fennec.data.atlas.input.mongo',\
	bnd.identity;id='org.eclipse.fennec.data.atlas.input.bridge',\
	bnd.identity;id='org.eclipse.fennec.data.atlas.datasource',\
	bnd.identity;id='org.eclipse.daanse.jdbc.datasource.h2',\
	bnd.identity;id='org.apache.felix.configadmin.plugin.interpolation',\
	bnd.identity;id='org.eclipse.fennec.data.atlas.transformation',\
	bnd.identity;id='org.eclipse.fennec.m2x.qvto.engine',\
	bnd.identity;id='org.eclipse.fennec.data.atlas.rest',\
	bnd.identity;id='org.eclipse.fennec.data.atlas.publication.dcat',\
	bnd.identity;id='org.eclipse.fennec.data.atlas.odata',\
	bnd.identity;id='org.eclipse.fennec.odata.runtime',\
	bnd.identity;id='org.eclipse.fennec.odata.persistence',\
	bnd.identity;id='org.eclipse.fennec.odata.metadata',\
	bnd.identity;id='org.eclipse.fennec.dcat.atlas.client.osgi',\
	bnd.identity;id='org.eclipse.fennec.dcat.atlas.client.impl',\
	bnd.identity;id='org.apache.aries.spifly.dynamic.bundle',\
	bnd.identity;id='org.eclipse.fennec.codec',\
	bnd.identity;id='org.eclipse.fennec.codec.rest',\
	bnd.identity;id='org.eclipse.fennec.codec.csv',\
	bnd.identity;id='org.eclipse.daanse.jdbc.datasource.postgresql',\
	bnd.identity;id='org.postgresql.jdbc',\
	bnd.identity;id='org.eclipse.fennec.emf.osgi.component.minimal',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.rest.client.osgi',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.rest.client.impl',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.rest.client.api',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.scope.api',\
	bnd.identity;id='org.eclipse.fennec.model.atlas.eobject.provider',\
	bnd.identity;id='org.eclipse.osgitech.rest.servlet.whiteboard',\
	bnd.identity;id='org.apache.felix.http.jetty12',\
	bnd.identity;id='org.apache.felix.configadmin',\
	bnd.identity;id='org.eclipse.fennec.persistence.eclipselink',\
	bnd.identity;id='org.eclipse.fennec.persistence.repository.jpa',\
	bnd.identity;id='org.eclipse.fennec.persistence.repository.mongo',\
	bnd.identity;id='org.eclipse.fennec.persistence.mongo',\
	bnd.identity;id='org.eclipse.persistence.jpa.jpql'

# only one emf.osgi runtime stack: the codec bundles are built against the
# 1.1.0 line (component.minimal); a second ResourceSetFactory provider from
# the 0.1.x line leads to EPackages registered in one registry and
# resources loaded via the other. The spifly framework extension's embedded
# ASM cannot read Java-21 class files; the dynamic bundle is used instead.
-runblacklist: \
	bnd.identity;id='org.eclipse.fennec.emf.osgi.component',\
	bnd.identity;id='org.eclipse.fennec.emf.osgi.component.minimal';version='[0.1.0,1.0.0)',\
	bnd.identity;id='org.apache.aries.spifly.dynamic.framework.extension'

-runprovidedcapabilities: ${native_capability}

-resolve.effective: active;skip:="osgi.service"

-runfw: org.apache.felix.framework;version='[7.0.5,7.0.5]'

-runee: JavaSE-21

# the interpolation plugin resolves the $[secret:NAME] credential placeholders
# of the materialized-data-source fixture against the checked-in test secrets
-runproperties: \
	org.osgi.service.http.port=-1,\
	felix.cm.config.plugins=org.apache.felix.configadmin.plugin.interpolation,\
	org.apache.felix.configadmin.plugin.interpolation.secretsdir=${workspace}/org.eclipse.fennec.data.atlas.tests/secrets,\
	${if;${is;${driver};gradle};gosh.args=--nointeractive}

# Ensure clean environment
-runkeep: false
