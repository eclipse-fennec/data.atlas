-library: enableOSGi-Test

-runrequires: \
	bnd.identity;id='org.eclipse.fennec.data.atlas.tests',\
	bnd.identity;id='org.eclipse.fennec.data.atlas.bootstrap',\
	bnd.identity;id='org.eclipse.fennec.data.atlas.input.file',\
	bnd.identity;id='org.eclipse.fennec.data.atlas.rest',\
	bnd.identity;id='org.eclipse.fennec.codec',\
	bnd.identity;id='org.eclipse.fennec.codec.rest',\
	bnd.identity;id='org.eclipse.fennec.emf.osgi.component.minimal',\
	bnd.identity;id='org.eclipse.osgitech.rest.servlet.whiteboard',\
	bnd.identity;id='org.apache.felix.http.jetty12',\
	bnd.identity;id='org.apache.felix.configadmin'

# only one emf.osgi runtime stack: the codec bundles are built against the
# 1.1.0 line (component.minimal); a second ResourceSetFactory provider from
# the 0.1.x line leads to EPackages registered in one registry and
# resources loaded via the other
-runblacklist: \
	bnd.identity;id='org.eclipse.fennec.emf.osgi.component',\
	bnd.identity;id='org.eclipse.fennec.emf.osgi.component.minimal';version='[0.1.0,1.0.0)'

# org.eclipse.fennec.persistence.orm (pulled in by the eorm imports of
# configuration.model, unused at runtime here) requires emf.core=osgi in
# [0,1.0) which only the blacklisted 0.1.x emf.osgi line provides; the real
# fix is a persistence rebuild against the emf.osgi 1.1 line
-runsystemcapabilities.emfcore: emf.core;emf.core=osgi;version:Version=0.1.2

-runprovidedcapabilities: ${native_capability}

-resolve.effective: active;skip:="osgi.service"

-runfw: org.apache.felix.framework;version='[7.0.5,7.0.5]'

-runee: JavaSE-21

-runproperties: \
	org.osgi.service.http.port=-1,\
	${if;${is;${driver};gradle};gosh.args=--nointeractive}

# Ensure clean environment
-runkeep: false
