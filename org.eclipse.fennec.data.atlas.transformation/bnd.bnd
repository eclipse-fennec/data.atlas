Bundle-Name: Fennec Data Atlas - Transformation
Bundle-Description: Transformation configurator: tracks DataTransformation configuration \
	services and registers one ready-to-execute DataTransformer per configuration, \
	executing the referenced QVT-O AST with the fennec m2x QVT-O engine.

-library: enableEMF

-buildpath: \
	org.osgi.service.component.annotations;version=latest,\
	org.osgi.service.component;version=latest,\
	org.eclipse.fennec.data.atlas.configuration.model;version=project,\
	org.eclipse.fennec.data.atlas.api;version=project,\
	org.eclipse.fennec.m2x.qvto.api;version=latest,\
	org.eclipse.fennec.m2x.qvto.model;version=latest,\
	org.eclipse.fennec.m2x.ocl.model;version=latest,\
	org.eclipse.fennec.m2x.qvt.model;version=latest
