Bundle-Name: Fennec Data Atlas - DCAT Publication
Bundle-Description: Omittable publication handler: tracks DataService configuration services \
	whose configuration declares a DcatPublication and keeps them registered with a \
	DCAT.Atlas portal through the dcat.atlas client - DataService-first (dcat:DataService \
	with endpoint URL), its DataSets as dcat:Dataset with one dcat:Distribution per \
	resolved DistributionExport. A runtime without this bundle is a complete Data Atlas.

-library: enableEMF

-buildpath: \
	org.osgi.service.component.annotations;version=latest,\
	org.osgi.service.component;version=latest,\
	org.osgi.service.metatype.annotations;version=latest,\
	org.eclipse.fennec.data.atlas.configuration.model;version=project,\
	org.eclipse.fennec.data.atlas.api;version=project,\
	org.eclipse.fennec.dcat.atlas.client.api;version=latest,\
	org.eclipse.fennec.dcat.atlas.dcatap.de.model;version=latest
