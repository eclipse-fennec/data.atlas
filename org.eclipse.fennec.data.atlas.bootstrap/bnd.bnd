Bundle-Name: Fennec Data Atlas - Bootstrap
Bundle-Description: File-mode configuration source: loads the DataAtlasConfiguration of this \
	instance from a configured URI, registers the EPackages of the model types it references, \
	and registers the contained configuration objects (DataServices, DataInputs) as OSGi \
	services that the per-technology configurators pick up.

-library: enableEMF

-buildpath: \
	org.osgi.service.component.annotations;version=latest,\
	org.osgi.service.metatype.annotations,\
	org.eclipse.fennec.data.atlas.configuration.model;version=project,\
	org.eclipse.fennec.atlas.configuration.model;version=latest,\
	org.eclipse.fennec.atlas.configuration.jpa.model;version=latest,\
	org.eclipse.fennec.atlas.configuration.qvto.model;version=latest,\
	org.eclipse.fennec.data.atlas.api;version=project,\
	org.eclipse.fennec.model.atlas.scope.api;version=latest,\
	org.eclipse.daanse.io.fs.watcher.api;version=latest,\
	org.eclipse.fennec.m2x.qvto.model;version=latest,\
	org.eclipse.fennec.m2x.ocl.model;version=latest,\
	org.eclipse.fennec.m2x.qvt.model;version=latest,\
	org.eclipse.fennec.emf.osgi.eobject.registry;version=latest

# No hand-maintained Import-Package for the configuration models: the registrar
# registers every configuration object with the context of the bundle that defines
# its type (data.atlas#34), so the bootstrap does not need to be wired to them.
