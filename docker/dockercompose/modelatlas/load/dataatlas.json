{
	":configurator:resource-version": 1,
	":configurator:symbolic-name": "org.eclipse.fennec.data.atlas.config.modelatlas",
	":configurator:version": "1.0.0",
	"ScopeService~dataatlas": {
		"atlas.scope": "dataatlas",
		"scope.name": "dataatlas",
		"scope.description": "Data Atlas configuration scope",
		"parent.scope": "atlas",
		"registryService.target": "(|(registry.name=schema)(registry.name=configurations))",
		"registryService.cardinality.minimum:int": 2
	},
	"RegistryService~configurations": {
		"registry.name": "configurations",
		"registry.description": "Registry holding DataAtlasConfiguration instances",
		"stage.storage.mappings": [
			"draft:file",
			"release:file"
		],
		"workflow.transitions": [
			"draft:release"
		],
		"delete.after.transition": true,
		"storageService.target": "(storage.type=file)",
		"storageService.cardinality.minimum:int": 1,
		"stages": [
			{
				"name": "draft",
				"writable": true,
				"final": false
			},
			{
				"name": "release",
				"writable": true,
				"final": true
			}
		],
		"schema.uri": "http://www.eclipse.org/emf/2002/Ecore",
		"root.eclass.uri": "http://www.eclipse.org/emf/2002/Ecore#//EObject",
		"resourceSet.target": "(emf.name=ecore)"
	}
}
